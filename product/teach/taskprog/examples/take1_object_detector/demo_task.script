# ----------------------------------------------------------------------
# Program : demo_task
# Task    : -
# Made by : cobot-teaching taskprog 0.2 from task.json (sha256 8679a0085d6d), cell ur5e_table
# Status  : NOT APPROVED. Run it in URSim first, then on the robot at reduced speed with an
#           engineer present. Do not edit by hand: change the task file and generate again.
# Units   : metres, radians, seconds (the task file uses mm and degrees)
# ----------------------------------------------------------------------
def demo_task():
  set_tcp(p[0, 0, 0.15, 0, 0, 0])
  set_payload(1)

  # Work frame: where the task's table sits in the robot base frame. Re-teach this one
  # pose to move the whole task.
  work = p[0.25, 0, 0, 0, 0, 0]

  # Locations, in the work frame: on the surface the object stands on, tool pointing down.
  # Heights above a location are pose_trans offsets along -tool z (straight up).
  loc_pick_1 = pose_trans(work, p[0.1658, 0.0495, 0, 3.141593, 0, 0])  # from demo step 1
  loc_place_1 = pose_trans(work, p[0.2487, -0.0708, 0, 3.141593, 0, 0])  # from demo step 3
  loc_place_2 = pose_trans(work, p[0.2332, -0.0378, 0, 3.141593, 0, 0])  # from demo step 7

  home_q = [3.141593, -1.570796, 1.570796, -1.570796, -1.570796, 0]

  def ct_gripper(close, settle_s):
    set_tool_digital_out(0, close)
    sleep(settle_s)
  end

  # start: home, gripper open
  movej(home_q, a=2.617994, v=1.047198)  # start at home
  ct_gripper(False, 0.5)  # open gripper
  textmsg("CT step 0 done ", get_actual_tcp_pose())

  # step 1/6: home  (start at home)
  textmsg("CT step 1 home")
  movej(home_q, a=2.617994, v=1.047198)  # home
  textmsg("CT step 1 done ", get_actual_tcp_pose())

  # step 2/6: pick juice_carton at pick_1  (pick (unlabelled))
  textmsg("CT step 2 pick juice_carton at pick_1")
  movej(get_inverse_kin(pose_trans(loc_pick_1, p[0, 0, -0.07, 0, 0, 0]), qnear=home_q), a=2.617994, v=1.047198)  # above pick_1
  movel(pose_trans(loc_pick_1, p[0, 0, -0.02, 0, 0, 0]), a=0.8, v=0.15)  # down to grasp height
  ct_gripper(True, 0.5)  # close gripper
  movel(pose_trans(loc_pick_1, p[0, 0, -0.07, 0, 0, 0]), a=0.8, v=0.15)  # back up from pick_1
  textmsg("CT step 2 done ", get_actual_tcp_pose())

  # step 3/6: place juice_carton at place_1  (place (unlabelled))
  textmsg("CT step 3 place juice_carton at place_1")
  movej(get_inverse_kin(pose_trans(loc_place_1, p[0, 0, -0.072, 0, 0, 0]), qnear=home_q), a=2.617994, v=1.047198)  # above place_1
  movel(pose_trans(loc_place_1, p[0, 0, -0.022, 0, 0, 0]), a=0.8, v=0.15)  # down to release height
  ct_gripper(False, 0.5)  # open gripper
  movel(pose_trans(loc_place_1, p[0, 0, -0.072, 0, 0, 0]), a=0.8, v=0.15)  # back up from place_1
  textmsg("CT step 3 done ", get_actual_tcp_pose())

  # step 4/6: pick juice_carton at place_1  (pick (unlabelled))
  textmsg("CT step 4 pick juice_carton at place_1")
  movej(get_inverse_kin(pose_trans(loc_place_1, p[0, 0, -0.07, 0, 0, 0]), qnear=home_q), a=2.617994, v=1.047198)  # above place_1
  movel(pose_trans(loc_place_1, p[0, 0, -0.02, 0, 0, 0]), a=0.8, v=0.15)  # down to grasp height
  ct_gripper(True, 0.5)  # close gripper
  movel(pose_trans(loc_place_1, p[0, 0, -0.07, 0, 0, 0]), a=0.8, v=0.15)  # back up from place_1
  textmsg("CT step 4 done ", get_actual_tcp_pose())

  # step 5/6: place juice_carton at place_2  (place (unlabelled))
  textmsg("CT step 5 place juice_carton at place_2")
  movej(get_inverse_kin(pose_trans(loc_place_2, p[0, 0, -0.072, 0, 0, 0]), qnear=home_q), a=2.617994, v=1.047198)  # above place_2
  movel(pose_trans(loc_place_2, p[0, 0, -0.022, 0, 0, 0]), a=0.8, v=0.15)  # down to release height
  ct_gripper(False, 0.5)  # open gripper
  movel(pose_trans(loc_place_2, p[0, 0, -0.072, 0, 0, 0]), a=0.8, v=0.15)  # back up from place_2
  textmsg("CT step 5 done ", get_actual_tcp_pose())

  # step 6/6: home  (back to home)
  textmsg("CT step 6 home")
  movej(home_q, a=2.617994, v=1.047198)  # home
  textmsg("CT step 6 done ", get_actual_tcp_pose())
  textmsg("CT program finished")
end
