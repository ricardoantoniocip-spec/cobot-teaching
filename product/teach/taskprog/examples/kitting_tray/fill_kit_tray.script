# ----------------------------------------------------------------------
# Program : fill_kit_tray
# Task    : Take six parts from the feeder and put one in every slot of a 3 x 2 kit tray.
# Made by : cobot-teaching taskprog 0.2 from task.json (sha256 ec91fe2fa5b1), cell ur5e_table
# Status  : NOT APPROVED. Run it in URSim first, then on the robot at reduced speed with an
#           engineer present. Do not edit by hand: change the task file and generate again.
# Units   : metres, radians, seconds (the task file uses mm and degrees)
# ----------------------------------------------------------------------
def fill_kit_tray():
  set_tcp(p[0, 0, 0.15, 0, 0, 0])
  set_payload(1)

  # Work frame: where the task's table sits in the robot base frame. Re-teach this one
  # pose to move the whole task.
  work = p[0.25, 0, 0, 0, 0, 0]

  # Locations, in the work frame: on the surface the object stands on, tool pointing down.
  # Heights above a location are pose_trans offsets along -tool z (straight up).
  loc_feeder = pose_trans(work, p[0.1, -0.25, 0, 3.141593, 0, 0])  # the feeder always presents the next part here
  loc_tray = pose_trans(work, p[0.15, 0.1, 0, 3.141593, 0, 0])  # slot 1 = corner nearest the robot
  # tray is a grid: 3 x 2 slots, pitch 60 x 60 mm. loc_tray is slot 1; re-teach it to move every slot.
  loc_tray_s1 = pose_trans(loc_tray, p[0, 0, 0, 0, 0, 0])  # column 1, row 1
  loc_tray_s2 = pose_trans(loc_tray, p[0.06, 0, 0, 0, 0, 0])  # column 2, row 1
  loc_tray_s3 = pose_trans(loc_tray, p[0.12, 0, 0, 0, 0, 0])  # column 3, row 1
  loc_tray_s4 = pose_trans(loc_tray, p[0, -0.06, 0, 0, 0, 0])  # column 1, row 2
  loc_tray_s5 = pose_trans(loc_tray, p[0.06, -0.06, 0, 0, 0, 0])  # column 2, row 2
  loc_tray_s6 = pose_trans(loc_tray, p[0.12, -0.06, 0, 0, 0, 0])  # column 3, row 2

  home_q = [3.141593, -1.570796, 1.570796, -1.570796, -1.570796, 0]

  def ct_gripper(close, settle_s):
    set_tool_digital_out(0, close)
    sleep(settle_s)
  end

  # start: home, gripper open
  movej(home_q, a=2.617994, v=1.047198)  # start at home
  ct_gripper(False, 0.4)  # open gripper
  textmsg("CT step 0 done ", get_actual_tcp_pose())

  # step 1/14: home
  textmsg("CT step 1 home")
  movej(home_q, a=2.617994, v=1.047198)  # home
  textmsg("CT step 1 done ", get_actual_tcp_pose())

  # step 2/14: pick part at feeder  (take the next part)
  textmsg("CT step 2 pick part at feeder")
  movej(get_inverse_kin(pose_trans(loc_feeder, p[0, 0, -0.085, 0, 0, 0]), qnear=home_q), a=2.617994, v=1.047198)  # above feeder
  movel(pose_trans(loc_feeder, p[0, 0, -0.025, 0, 0, 0]), a=0.8, v=0.15)  # down to grasp height
  ct_gripper(True, 0.4)  # close gripper
  movel(pose_trans(loc_feeder, p[0, 0, -0.085, 0, 0, 0]), a=0.8, v=0.15)  # back up from feeder
  textmsg("CT step 2 done ", get_actual_tcp_pose())

  # step 3/14: place part at tray slot 1  (put it in the next free slot)
  textmsg("CT step 3 place part at tray slot 1")
  movej(get_inverse_kin(pose_trans(loc_tray_s1, p[0, 0, -0.087, 0, 0, 0]), qnear=home_q), a=1.396263, v=0.523599)  # above tray slot 1
  movel(pose_trans(loc_tray_s1, p[0, 0, -0.027, 0, 0, 0]), a=0.3, v=0.05)  # down to release height
  ct_gripper(False, 0.4)  # open gripper
  movel(pose_trans(loc_tray_s1, p[0, 0, -0.087, 0, 0, 0]), a=0.3, v=0.05)  # back up from tray slot 1
  textmsg("CT step 3 done ", get_actual_tcp_pose())

  # step 4/14: pick part at feeder  (take the next part)
  textmsg("CT step 4 pick part at feeder")
  movej(get_inverse_kin(pose_trans(loc_feeder, p[0, 0, -0.085, 0, 0, 0]), qnear=home_q), a=2.617994, v=1.047198)  # above feeder
  movel(pose_trans(loc_feeder, p[0, 0, -0.025, 0, 0, 0]), a=0.8, v=0.15)  # down to grasp height
  ct_gripper(True, 0.4)  # close gripper
  movel(pose_trans(loc_feeder, p[0, 0, -0.085, 0, 0, 0]), a=0.8, v=0.15)  # back up from feeder
  textmsg("CT step 4 done ", get_actual_tcp_pose())

  # step 5/14: place part at tray slot 2  (put it in the next free slot)
  textmsg("CT step 5 place part at tray slot 2")
  movej(get_inverse_kin(pose_trans(loc_tray_s2, p[0, 0, -0.087, 0, 0, 0]), qnear=home_q), a=1.396263, v=0.523599)  # above tray slot 2
  movel(pose_trans(loc_tray_s2, p[0, 0, -0.027, 0, 0, 0]), a=0.3, v=0.05)  # down to release height
  ct_gripper(False, 0.4)  # open gripper
  movel(pose_trans(loc_tray_s2, p[0, 0, -0.087, 0, 0, 0]), a=0.3, v=0.05)  # back up from tray slot 2
  textmsg("CT step 5 done ", get_actual_tcp_pose())

  # step 6/14: pick part at feeder  (take the next part)
  textmsg("CT step 6 pick part at feeder")
  movej(get_inverse_kin(pose_trans(loc_feeder, p[0, 0, -0.085, 0, 0, 0]), qnear=home_q), a=2.617994, v=1.047198)  # above feeder
  movel(pose_trans(loc_feeder, p[0, 0, -0.025, 0, 0, 0]), a=0.8, v=0.15)  # down to grasp height
  ct_gripper(True, 0.4)  # close gripper
  movel(pose_trans(loc_feeder, p[0, 0, -0.085, 0, 0, 0]), a=0.8, v=0.15)  # back up from feeder
  textmsg("CT step 6 done ", get_actual_tcp_pose())

  # step 7/14: place part at tray slot 3  (put it in the next free slot)
  textmsg("CT step 7 place part at tray slot 3")
  movej(get_inverse_kin(pose_trans(loc_tray_s3, p[0, 0, -0.087, 0, 0, 0]), qnear=home_q), a=1.396263, v=0.523599)  # above tray slot 3
  movel(pose_trans(loc_tray_s3, p[0, 0, -0.027, 0, 0, 0]), a=0.3, v=0.05)  # down to release height
  ct_gripper(False, 0.4)  # open gripper
  movel(pose_trans(loc_tray_s3, p[0, 0, -0.087, 0, 0, 0]), a=0.3, v=0.05)  # back up from tray slot 3
  textmsg("CT step 7 done ", get_actual_tcp_pose())

  # step 8/14: pick part at feeder  (take the next part)
  textmsg("CT step 8 pick part at feeder")
  movej(get_inverse_kin(pose_trans(loc_feeder, p[0, 0, -0.085, 0, 0, 0]), qnear=home_q), a=2.617994, v=1.047198)  # above feeder
  movel(pose_trans(loc_feeder, p[0, 0, -0.025, 0, 0, 0]), a=0.8, v=0.15)  # down to grasp height
  ct_gripper(True, 0.4)  # close gripper
  movel(pose_trans(loc_feeder, p[0, 0, -0.085, 0, 0, 0]), a=0.8, v=0.15)  # back up from feeder
  textmsg("CT step 8 done ", get_actual_tcp_pose())

  # step 9/14: place part at tray slot 4  (put it in the next free slot)
  textmsg("CT step 9 place part at tray slot 4")
  movej(get_inverse_kin(pose_trans(loc_tray_s4, p[0, 0, -0.087, 0, 0, 0]), qnear=home_q), a=1.396263, v=0.523599)  # above tray slot 4
  movel(pose_trans(loc_tray_s4, p[0, 0, -0.027, 0, 0, 0]), a=0.3, v=0.05)  # down to release height
  ct_gripper(False, 0.4)  # open gripper
  movel(pose_trans(loc_tray_s4, p[0, 0, -0.087, 0, 0, 0]), a=0.3, v=0.05)  # back up from tray slot 4
  textmsg("CT step 9 done ", get_actual_tcp_pose())

  # step 10/14: pick part at feeder  (take the next part)
  textmsg("CT step 10 pick part at feeder")
  movej(get_inverse_kin(pose_trans(loc_feeder, p[0, 0, -0.085, 0, 0, 0]), qnear=home_q), a=2.617994, v=1.047198)  # above feeder
  movel(pose_trans(loc_feeder, p[0, 0, -0.025, 0, 0, 0]), a=0.8, v=0.15)  # down to grasp height
  ct_gripper(True, 0.4)  # close gripper
  movel(pose_trans(loc_feeder, p[0, 0, -0.085, 0, 0, 0]), a=0.8, v=0.15)  # back up from feeder
  textmsg("CT step 10 done ", get_actual_tcp_pose())

  # step 11/14: place part at tray slot 5  (put it in the next free slot)
  textmsg("CT step 11 place part at tray slot 5")
  movej(get_inverse_kin(pose_trans(loc_tray_s5, p[0, 0, -0.087, 0, 0, 0]), qnear=home_q), a=1.396263, v=0.523599)  # above tray slot 5
  movel(pose_trans(loc_tray_s5, p[0, 0, -0.027, 0, 0, 0]), a=0.3, v=0.05)  # down to release height
  ct_gripper(False, 0.4)  # open gripper
  movel(pose_trans(loc_tray_s5, p[0, 0, -0.087, 0, 0, 0]), a=0.3, v=0.05)  # back up from tray slot 5
  textmsg("CT step 11 done ", get_actual_tcp_pose())

  # step 12/14: pick part at feeder  (take the next part)
  textmsg("CT step 12 pick part at feeder")
  movej(get_inverse_kin(pose_trans(loc_feeder, p[0, 0, -0.085, 0, 0, 0]), qnear=home_q), a=2.617994, v=1.047198)  # above feeder
  movel(pose_trans(loc_feeder, p[0, 0, -0.025, 0, 0, 0]), a=0.8, v=0.15)  # down to grasp height
  ct_gripper(True, 0.4)  # close gripper
  movel(pose_trans(loc_feeder, p[0, 0, -0.085, 0, 0, 0]), a=0.8, v=0.15)  # back up from feeder
  textmsg("CT step 12 done ", get_actual_tcp_pose())

  # step 13/14: place part at tray slot 6  (put it in the next free slot)
  textmsg("CT step 13 place part at tray slot 6")
  movej(get_inverse_kin(pose_trans(loc_tray_s6, p[0, 0, -0.087, 0, 0, 0]), qnear=home_q), a=1.396263, v=0.523599)  # above tray slot 6
  movel(pose_trans(loc_tray_s6, p[0, 0, -0.027, 0, 0, 0]), a=0.3, v=0.05)  # down to release height
  ct_gripper(False, 0.4)  # open gripper
  movel(pose_trans(loc_tray_s6, p[0, 0, -0.087, 0, 0, 0]), a=0.3, v=0.05)  # back up from tray slot 6
  textmsg("CT step 13 done ", get_actual_tcp_pose())

  # step 14/14: home
  textmsg("CT step 14 home")
  movej(home_q, a=2.617994, v=1.047198)  # home
  textmsg("CT step 14 done ", get_actual_tcp_pose())
  textmsg("CT program finished")
end
